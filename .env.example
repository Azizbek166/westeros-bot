# Telegram Bot Token (BotFather dan olingan yangi token)
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Connection String (500+ player ishlab chiqarish uchun)
# DATABASE_URL=postgresql+asyncpg://postgres:parol@localhost:5432/got_mmorpg

# Yoki SQLite asinxron (sinov va lokal ishlatish uchun)
DATABASE_URL=sqlite+aiosqlite:///got_mmorpg.db

# Xatolar va baglar avtomatik yuboriladigan yopiq Telegram guruhi ID si (masalan: -1001234567890)
ERROR_CHAT_ID=-1001234567890

# AI Kengash Maslahatchisi (Google Gemini API)
# Agar kalit ko'rsatilmasa, o'yin ichki Westeros Maester qoidalar tizimidan avtomatik foydalanadi
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_USER_DAILY_LIMIT=10
AI_VIP_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=500

